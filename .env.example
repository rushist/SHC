# =================================================================
# SELF-HEALING DISTRIBUTED CACHE — ENVIRONMENT CONFIGURATION
# =================================================================

# --- Gateway Router (:8000) ---
PORT=8000
HOST=0.0.0.0
GATEWAY_NODES=node-a=http://localhost:8001,node-b=http://localhost:8002,node-c=http://localhost:8003
VNODES=50
HEARTBEAT_INTERVAL=500ms
SUSPECT_TIMEOUT=1s
FAIL_TIMEOUT=2s
REQUEST_TIMEOUT=2s

# --- Next.js Dashboard (:3000) ---
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000
NEXT_PUBLIC_NODE_A_URL=http://localhost:8001
NEXT_PUBLIC_NODE_B_URL=http://localhost:8002
NEXT_PUBLIC_NODE_C_URL=http://localhost:8003

# --- Storage Node Settings (Optional Per-Node Overrides) ---
CACHE_NODE_ID=node-a
CACHE_HOST=0.0.0.0
CACHE_PEERS=node-b=http://localhost:8002,node-c=http://localhost:8003
CLEANUP_INTERVAL=1s
PING_TIMEOUT=2s
HOTKEY_WINDOW=5s
HOTKEY_THRESHOLD=20
