# ==============================================================================
# SELF-HEALING DISTRIBUTED CACHE (SHC) — AWS PROTOTYPE CONFIGURATION TEMPLATE
# ==============================================================================

# --- Node Identity & Failure Domain ---
NODE_ID=node-a
HOST_ID=EC2-A
NODE_ADDRESS=0.0.0.0
NODE_PORT=8001

# --- Inter-Node Private Communication (Use EC2 Private IPs or Internal DNS) ---
# Format: comma-separated list of http://<private-ip>:<port>
PEER_NODES=http://10.0.1.10:8001,http://10.0.1.10:8002,http://10.0.1.10:8003,http://10.0.1.11:8001,http://10.0.1.11:8002,http://10.0.1.11:8003,http://10.0.1.12:8001,http://10.0.1.12:8002,http://10.0.1.12:8003
REPLICATION_FACTOR=2

# --- Amazon RDS for PostgreSQL (Persistent Backing Database in ap-south-1 Mumbai) ---
DATABASE_URL=postgres://postgres:YourSecurePassword@shc-postgres.c123456789.ap-south-1.rds.amazonaws.com:5432/shc_db?sslmode=require
DATABASE_HOST=shc-postgres.c123456789.ap-south-1.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_NAME=shc_db
DATABASE_USER=postgres
DATABASE_PASSWORD=YourSecurePassword
DATABASE_SSLMODE=require

# --- Gateway Router & Dashboard Settings ---
GATEWAY_PORT=8000
DASHBOARD_PORT=3000
ROUTER_HOST=0.0.0.0
NEXT_PUBLIC_ROUTER_URL=http://<GATEWAY_PUBLIC_IP>:8000

# --- Health Check & Failover Tuning ---
HEARTBEAT_INTERVAL=500ms
SUSPECT_TIMEOUT=1s
FAIL_TIMEOUT=2s
REQUEST_TIMEOUT=2s
CLEANUP_INTERVAL=1s
